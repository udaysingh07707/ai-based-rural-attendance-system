# PostgreSQL connection string for local development or your hosted database.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
SESSION_SECRET="generate-a-random-secret-of-at-least-32-bytes"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-sender-gmail@gmail.com"
SMTP_PASS="your-16-character-google-app-password"
EMAIL_FROM="School Attendance <your-sender-gmail@gmail.com>"

# Private, self-hosted face inference. Keep recognition disabled until thresholds
# are evaluated with consented, known-identity sample images.
FACE_SERVICE_URL="http://127.0.0.1:8765"
FACE_SERVICE_TOKEN="generate-a-random-shared-service-token"
FACE_TEMPLATE_ENCRYPTION_KEYS='{"k1":"base64-encoded-random-32-byte-key"}'
FACE_TEMPLATE_KEY_VERSION="k1"
FACE_ENROLLMENT_MIN_DETECTION_SCORE="0.9"
FACE_RECOGNITION_ENABLED="false"
FACE_MATCH_THRESHOLD=""
FACE_MATCH_MARGIN=""
